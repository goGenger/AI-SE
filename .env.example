NODE_ENV=development
PORT=3000
POSTGRES_USER=aise
POSTGRES_DB=aise
DATABASE_URL=postgres://aise@localhost:5432/aise
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
# debug|info|warn|error|silent — info already prints warn+error; Error stacks need sanitizeLogData fix (not a higher level)
LOG_LEVEL=info

# ── Model API configuration ────────────────────────────────────────────────
# "mock" = deterministic local stand-ins (no external calls);
# "openai" = any OpenAI-compatible endpoint (OpenAI, DeepSeek, local servers…)
# The OPENAI_* settings below are the single source for every real-model path:
# planning, professional workflow agents, and the bug-fix coding agent.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Custom OpenAI-compatible endpoint, e.g. https://api.deepseek.com/v1
OPENAI_BASE_URL=
# PL-C2: USD per 1M tokens, used to estimate agent run cost. Set BOTH or neither —
# unset means estimated_cost stays NULL (never a guessed number).
MODEL_INPUT_PRICE_PER_MTOK=
MODEL_OUTPUT_PRICE_PER_MTOK=
# Structured-output strategy for planning stages:
# jsonSchema (default) | functionCalling | jsonMode
# DeepSeek: use jsonMode — json_schema response_format is unavailable on their
# API, and their thinking models reject the forced tool_choice that
# functionCalling sends. For OpenAI (or compatible endpoints that support
# them) keep jsonSchema or functionCalling.
OPENAI_STRUCTURED_OUTPUT_METHOD=

AGENT_WORKSPACE_ROOT=.
# 任务级 Agent 运行预算(ms),默认 1800000 (30min);单个任务可用 input.execution.timeoutMs 覆盖。
TASK_TIMEOUT_MS=1800000
# 前端统一走同源 /api，由 Vite dev server 代理到 :3000；一般留空即可。
VITE_API_BASE_URL=
CI_PROVIDER=local
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
DELIVERY_DOCKER_COMMAND=docker
