{
  "name": "@ai-se/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "typecheck": "pnpm --filter @ai-se/shared build && vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "a11y": "node scripts/a11y.mjs",
    "a11y:tree": "node scripts/a11yTree.mjs"
  },
  "dependencies": {
    "@ai-se/shared": "workspace:*",
    "@lucide/vue": "1.46.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "pinia": "4.0.3",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "axe-core": "4.14.0",
    "playwright": "1.61.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
