{
  "name": "taskboard-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite preview --host 127.0.0.1 --port ${PORT:-4173} --strictPort",
    "dev": "vite --host 127.0.0.1 --port ${PORT:-5173}",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "mock": "node mock-server.mjs"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "typescript": "5.6.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.13"
  }
}
